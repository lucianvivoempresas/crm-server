# 📧 Configuração de Email (SMTP)
# Descomente a opção que deseja usar
# ⚠️  NÃO compartilhe este arquivo ou coloque no Git!

# Obrigatório em produção. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Caminhos persistentes (recomendado apontar para um volume com backup externo)
# CRM_DB_PATH=/var/lib/crm/crm_database.sqlite
# ENERGIA_DB_PATH=/var/lib/crm/energia_database.sqlite
# DB_BACKUP_DIR=/var/backups/crm
# SQLITE_BACKUP_RETENTION=30
# ENERGIA_BACKUP_RETENTION=200
# ENERGIA_PERIODIC_BACKUP_MINUTES=180

# Integração Chatwoot → EnergiaVolt. Gere um segredo exclusivo com:
# openssl rand -hex 32
CHATWOOT_INTEGRATION_TOKEN=gere-outro-segredo-aleatorio
CHATWOOT_PUBLIC_URL=https://chat.voltconect.com.br

# ============================================
# OPÇÃO 1: Gmail (Recomendado para Testes)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Para obter senha de app Gmail:
# 1. https://myaccount.google.com
# 2. Segurança > Senhas de app
# 3. Selecione Mail e Windows
# 4. Copie a senha gerada


# ============================================
# OPÇÃO 2: Outlook/Hotmail
# ============================================
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=seu-email@hotmail.com
# SMTP_PASS=sua-senha-outlook


# ============================================
# AJUSTES DE PERFORMANCE
# ============================================
# SMTP_FROM="Volt Conect <seu-email@hotmail.com>"
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100
# SMTP_RATE_DELTA_MS=1000
# SMTP_RATE_LIMIT=20
# EMAIL_BATCH_SIZE=10
# EMAIL_BATCH_DELAY_MS=250



